{
	"files": {
		"includes": [
			"**",
			"!**/build",
			"!**/coverage",
			"!**/.taskgraph/**/tasks",
			"!**/.taskmaster/tasks",
			"!**/package-lock.json",
			"!**/tests/fixture/**/*.json",
			"!**/dist"
		]
	},
	"formatter": {
		"bracketSpacing": true,
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	},
	"markdown": {
		"formatter": {
			"formatEmbeds": false
		},
		"parser": {
			"frontmatter": true
		}
	},
	"linter": {
		"enabled": false,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noForEach": "off",
				"useOptionalChain": "off",
				"useArrowFunction": "off"
			},
			"correctness": {
				"noConstantCondition": "off",
				"noUnreachable": "off"
			},
			"suspicious": {
				"noDuplicateTestHooks": "off",
				"noPrototypeBuiltins": "off"
			},
			"style": {
				"noUselessElse": "off",
				"useNodejsImportProtocol": "off",
				"useNumberNamespace": "off",
				"noParameterAssign": "off",
				"useTemplate": "off",
				"noUnusedTemplateLiteral": "off",
				"noNonNullAssertion": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"CHANGELOG.md",
				".claude/rules/commands.md",
				".claude/rules/ui.md",
				".taskgraph/archive/2025-upstream/docs/autonomous-tdd-git-workflow.md",
				".taskgraph/templates/example_prd.md",
				".taskgraph/templates/example_prd_rpg.md",
				"packages/tm-core/tests/fixtures/prd/bookmarks.md",
				"packages/tm-core/tests/fixtures/prd/bookmarks-renamed.md"
			],
			"formatter": {
				"enabled": false
			}
		}
	]
}
