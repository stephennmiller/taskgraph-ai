{
	"name": "taskgraph-ai",
	"version": "0.52.1",
	"description": "Task management for AI-driven development, built for Claude Code: plan from a PRD, then work tasks one at a time with slash commands, a CLI or an MCP server.",
	"main": "index.js",
	"type": "module",
	"bin": {
		"taskgraph": "dist/taskgraph.js",
		"taskgraph-mcp": "dist/mcp-server.js",
		"taskgraph-ai": "dist/mcp-server.js"
	},
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"prepare": "node .githooks/install.mjs",
		"build": "npm run build:build-config && cross-env NODE_ENV=production tsdown",
		"dev": "tsdown --watch",
		"turbo:dev": "turbo dev",
		"turbo:build": "turbo build",
		"turbo:typecheck": "turbo typecheck",
		"turbo:test": "turbo test",
		"turbo:test:unit": "turbo test:unit",
		"turbo:test:integration": "turbo test:integration",
		"build:build-config": "npm run build -w @tm/build-config",
		"test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest",
		"test:sdk-contract": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest tests/sdk-contract --testPathIgnorePatterns /node_modules/",
		"test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=unit",
		"test:integration": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=integration",
		"test:fails": "node --experimental-vm-modules node_modules/.bin/jest --onlyFailures",
		"test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
		"test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
		"test:ci": "node --experimental-vm-modules node_modules/.bin/jest --coverage --ci",
		"test:e2e": "./tests/e2e/run_e2e.sh",
		"test:e2e-report": "./tests/e2e/run_e2e.sh --analyze-log",
		"postpack": "chmod +x dist/taskgraph.js dist/mcp-server.js",
		"changeset": "changeset",
		"publish-packages": "turbo run build lint test && changeset version && changeset publish",
		"inspector": "npx @modelcontextprotocol/inspector node dist/mcp-server.js",
		"mcp-server": "node dist/mcp-server.js",
		"format-check": "biome format .",
		"format": "biome format . --write",
		"deps:check": "manypkg check || echo 'Note: Workspace package version warnings are expected for internal @tm/* packages'",
		"deps:fix": "manypkg fix"
	},
	"keywords": [
		"claude",
		"task",
		"management",
		"ai",
		"development",
		"cursor",
		"anthropic",
		"llm",
		"mcp",
		"context"
	],
	"author": "Eyal Toledano",
	"license": "MIT WITH Commons-Clause",
	"dependencies": {
		"@inquirer/search": "^3.0.15",
		"@streamparser/json": "^0.0.26",
		"@types/turndown": "^5.0.6",
		"ai": "^7.0.143",
		"ai-sdk-provider-claude-code": "^4.3.3",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"boxen": "^8.0.1",
		"chalk": "5.6.2",
		"cli-highlight": "^2.1.11",
		"cli-progress": "^3.12.0",
		"cli-table3": "^0.6.5",
		"commander": "^12.1.0",
		"cors": "^2.8.6",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.7",
		"express": "^4.21.2",
		"fastmcp": "^4.22.4",
		"figlet": "^1.12.0",
		"fs-extra": "^11.4.1",
		"fuse.js": "^7.5.0",
		"gpt-tokens": "^1.3.14",
		"gradient-string": "^3.0.0",
		"helmet": "^8.3.0",
		"inquirer": "^12.5.0",
		"jsonc-parser": "^3.3.1",
		"jsonrepair": "^3.15.0",
		"jsonwebtoken": "^9.0.3",
		"lru-cache": "^10.2.0",
		"marked": "^15.0.12",
		"marked-terminal": "^7.3.0",
		"open": "^10.2.0",
		"ora": "^9.4.1",
		"proper-lockfile": "^4.1.2",
		"simple-git": "^4.0.2",
		"steno": "^4.0.2",
		"terminal-link": "^5.0.0",
		"turndown": "^7.2.4",
		"undici": "^8.11.2",
		"uuid": "^14.0.3",
		"zod": "^4.1.12"
	},
	"optionalDependencies": {
		"@anthropic-ai/claude-code": "^2.1.296",
		"@biomejs/cli-linux-x64": "^1.9.4"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "npm@11.21.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stephennmiller/taskgraph-ai.git"
	},
	"homepage": "https://github.com/stephennmiller/taskgraph-ai#readme",
	"bugs": {
		"url": "https://github.com/stephennmiller/taskgraph-ai/issues"
	},
	"files": [
		"dist/**",
		"README-upstream.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"overrides": {
		"node-fetch": "^2.6.12",
		"whatwg-url": "^11.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@manypkg/cli": "^0.25.1",
		"@tm/cli": "*",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^30.0.0",
		"@types/marked-terminal": "^6.1.1",
		"@vitest/coverage-v8": "^4.1.0",
		"concurrently": "^10.0.6",
		"cross-env": "^10.0.0",
		"execa": "^8.0.1",
		"jest": "^30.5.2",
		"jest-environment-node": "^29.7.0",
		"js-yaml": "^4.1.1",
		"mock-fs": "^5.5.0",
		"prettier": "^3.9.10",
		"supertest": "^7.3.1",
		"ts-jest": "^29.4.14",
		"tsdown": "^0.15.2",
		"tsx": "^4.23.15",
		"turbo": "2.11.7",
		"typescript": "^5.9.2"
	}
}
