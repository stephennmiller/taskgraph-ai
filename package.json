{
	"name": "taskgraph-ai",
	"version": "0.59.0",
	"description": "Task management for AI-driven development, built for Claude Code: plan from a PRD, then work tasks one at a time with slash commands, a CLI or an MCP server.",
	"type": "module",
	"bin": {
		"taskgraph": "dist/taskgraph.js",
		"taskgraph-mcp": "dist/mcp-server.js",
		"taskgraph-ai": "dist/mcp-server.js"
	},
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"prepare": "node .githooks/install.mjs",
		"build": "npm run build:build-config && cross-env NODE_ENV=production tsdown",
		"dev": "tsdown --watch",
		"turbo:dev": "turbo dev",
		"turbo:build": "turbo build",
		"turbo:typecheck": "turbo typecheck",
		"typecheck:root": "tsc --noEmit -p tsconfig.json",
		"turbo:test": "turbo test",
		"turbo:test:unit": "turbo test:unit",
		"turbo:test:integration": "turbo test:integration",
		"build:build-config": "npm run build -w @tm/build-config",
		"test": "cross-env NODE_ENV=test vitest run -c vitest.root.config.ts",
		"evals": "tsx evals/run.ts",
		"smoke:mcp": "node apps/mcp/tests/smoke/mcp-stdio.smoke.mjs --tools all",
		"test:sdk-contract": "cross-env NODE_ENV=test vitest run -c vitest.sdk-contract.config.ts",
		"test:unit": "cross-env NODE_ENV=test vitest run -c vitest.root.config.ts unit",
		"test:integration": "cross-env NODE_ENV=test vitest run -c vitest.root.config.ts integration",
		"test:watch": "cross-env NODE_ENV=test vitest -c vitest.root.config.ts",
		"test:coverage": "cross-env NODE_ENV=test vitest run -c vitest.root.config.ts --coverage",
		"test:ci": "cross-env NODE_ENV=test vitest run -c vitest.root.config.ts --coverage",
		"postpack": "chmod +x dist/taskgraph.js dist/mcp-server.js",
		"changeset": "changeset",
		"publish-packages": "turbo run build lint test && changeset version && changeset publish",
		"inspector": "npx @modelcontextprotocol/inspector node dist/mcp-server.js",
		"mcp-server": "node dist/mcp-server.js",
		"format-check": "biome format .",
		"format": "biome format . --write",
		"knip": "npm run build:build-config && knip",
		"deps:check": "manypkg check || echo 'Note: Workspace package version warnings are expected for internal @tm/* packages'",
		"deps:fix": "manypkg fix"
	},
	"keywords": [
		"claude-code",
		"claude-code-plugin",
		"claude",
		"anthropic",
		"ai-agents",
		"ai-coding",
		"task-management",
		"task-manager",
		"task-graph",
		"dependency-graph",
		"prd",
		"mcp",
		"model-context-protocol",
		"cli",
		"llm"
	],
	"author": "Stephen Miller",
	"license": "MIT WITH Commons-Clause",
	"dependencies": {
		"@types/turndown": "^5.0.6",
		"ai": "^7.0.143",
		"ai-sdk-provider-claude-code": "^4.3.3",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"chalk": "6.0.1",
		"cli-table3": "^0.6.5",
		"commander": "^15.0.0",
		"dotenv": "^18.0.7",
		"fastmcp": "^4.22.4",
		"fuse.js": "^7.5.0",
		"gradient-string": "^3.0.0",
		"inquirer": "^14.2.3",
		"jsonrepair": "^3.15.0",
		"marked": "^15.0.12",
		"marked-terminal": "^7.3.0",
		"ora": "^9.4.1",
		"proper-lockfile": "^4.1.2",
		"simple-git": "^4.0.2",
		"steno": "^4.0.2",
		"terminal-link": "^5.0.0",
		"turndown": "^7.2.4",
		"undici": "^7.30.1",
		"zod": "^4.1.12"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "npm@11.21.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stephennmiller/taskgraph-ai.git"
	},
	"homepage": "https://taskgraph-ai.com",
	"bugs": {
		"url": "https://github.com/stephennmiller/taskgraph-ai/issues"
	},
	"files": [
		"dist/**",
		"README-upstream.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"overrides": {
		"node-fetch": "^2.6.12",
		"whatwg-url": "^11.0.0",
		"axios": "^1.20.0",
		"qs": "^6.16.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@manypkg/cli": "^0.25.1",
		"@tm/build-config": "*",
		"@tm/cli": "*",
		"@tm/core": "*",
		"@tm/mcp": "*",
		"@tm/profiles": "*",
		"@types/marked-terminal": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.5",
		"cross-env": "^10.0.0",
		"js-yaml": "^5.4.3",
		"knip": "^6.42.1",
		"mock-fs": "^5.5.0",
		"tsdown": "^0.23.1",
		"tsx": "^4.23.15",
		"turbo": "2.11.8",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
