{
	"name": "@tm/core",
	"private": true,
	"description": "Core library for TaskGraph - TypeScript task management system",
	"type": "module",
	"types": "./src/index.ts",
	"main": "./dist/index.js",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"test:unit": "vitest run .spec.ts",
		"test:integration": "vitest run .test.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"lint:fix": "biome check --fix --unsafe",
		"format": "biome format --write",
		"format:check": "biome format",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tm/profiles": "*",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"ai": "^7.0.143",
		"ai-sdk-provider-claude-code": "^4.3.3",
		"date-fns": "^4.4.0",
		"fuse.js": "^7.5.0",
		"jsonrepair": "^3.15.0",
		"proper-lockfile": "^4.1.2",
		"simple-git": "^4.0.2",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@types/proper-lockfile": "^4.1.4",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"keywords": [
		"task-management",
		"typescript",
		"ai",
		"prd",
		"parser"
	],
	"author": "TaskGraph",
	"version": ""
}
