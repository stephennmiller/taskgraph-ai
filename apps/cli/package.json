{
	"name": "@tm/cli",
	"description": "TaskGraph CLI - Command line interface for task management",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./help": "./src/help.ts",
		"./theme": "./src/ui/theme.ts",
		"./errors": "./src/utils/error-handler.ts",
		"./suggested-actions": "./src/ui/suggested-actions.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run '**/*.spec.ts'",
		"test:integration": "vitest run '**/*.test.ts'",
		"test:smoke": "vitest run tests/integration/task-lifecycle.test.ts tests/integration/lock-interop.test.ts tests/integration/commands/first-run.command.test.ts tests/integration/commands/help.command.test.ts tests/integration/commands/version.command.test.ts tests/integration/commands/list.command.test.ts tests/integration/commands/next.command.test.ts tests/integration/commands/show.command.test.ts tests/integration/commands/set-status.command.test.ts",
		"test:ci": "vitest run --coverage --reporter=dot"
	},
	"dependencies": {
		"@tm/core": "*",
		"chalk": "6.0.1",
		"cli-table3": "^0.6.5",
		"commander": "^15.0.0",
		"figlet": "^1.12.0",
		"gradient-string": "^3.0.0",
		"inquirer": "^14.2.3",
		"ora": "^9.4.1",
		"terminal-link": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"tsx": "^4.23.15",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"keywords": [
		"taskgraph",
		"cli",
		"task-management",
		"productivity"
	],
	"author": "",
	"license": "MIT",
	"typesVersions": {
		"*": {
			"*": [
				"src/*"
			]
		}
	},
	"version": ""
}
