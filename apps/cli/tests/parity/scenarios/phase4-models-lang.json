		{
			"shell": "rm .taskgraph/config.json"
		},
		{
			"mcp": "models",
			"input": {
				"projectRoot": "<project>"
			},
			"expectError": true
		},
		{
			"mcp": "response-language",
			"input": {
				"projectRoot": "<project>",
				"language": "English"
