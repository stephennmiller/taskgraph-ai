			"shell": "mkdir -p .taskgraph/reports && printf '%s' '{\"meta\":{},\"complexityAnalysis\":[{\"taskId\":5,\"recommendedSubtasks\":0},{\"taskId\":4,\"recommendedSubtasks\":3,\"expansionPrompt\":\"Split by section\",\"reasoning\":\"Long\"}]}' > .taskgraph/reports/task-complexity-report.json"
